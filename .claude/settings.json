{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Monitor"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git clean -f*)",
      "Bash(git * --no-verify*)",
      "Bash(git *--no-gpg-sign*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f *)",
      "Bash(git * push --force-with-lease*)",
      "Bash(git * reset --hard*)",
      "Bash(git * rebase*)",
      "Bash(git * commit --amend*)",
      "Bash(git * clean -f*)",
      "Bash(git push *:*)",
      "Bash(git * --no-verify*)",

      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(chmod -R *)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",

      "Bash(* | sudo *)",
      "Bash(curl * | *sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | *sh*)",

      "Bash(* > .claude/settings*)",
      "Bash(* >> .claude/settings*)",
      "Bash(tee .claude/settings*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",

      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",

      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)"
    ]
  }
}
